# Connessione al database Postgres del Gestionale Edicola (stesso DB su Render)
# Su Render: usa la "Internal Database URL" del tuo Postgres
DATABASE_URL=postgresql://user:password@host/dbname

# Porta HTTP del servizio
PORT=8090

# Intervallo tra un ciclo di scaricamento automatico e l'altro (minuti)
INTERVALLO_MINUTI=20

# Quanti giorni indietro recuperare (oltre a oggi e domani)
GIORNI_INDIETRO=14

# Dopo quanti tentativi falliti/vuoti smettere di riprovare per una bolla
MAX_TENTATIVI=15
